---
const WA_NUMBER = '573000000000'; // reemplaza con número real
---

<section class="cta" id="contacto">
  <div class="wrap">
    <h2 class="reveal">¿Listo para que tu marca destaque?</h2>
    <p class="reveal">Cuéntanos tu idea por WhatsApp y agendamos una llamada sin compromiso.</p>
    <a
      href={`https://wa.me/${WA_NUMBER}`}
      class="btn btn--light reveal"
      target="_blank"
      rel="noopener noreferrer"
    >
      Hablemos hoy →
    </a>
  </div>
</section>

<style>
.cta {
  background: var(--blue);
  color: var(--cream);
  text-align: center;
  padding: clamp(90px, 14vh, 160px) 0;
}
.cta h2 {
  font-size: clamp(2.6rem, 7vw, 5.5rem);
  font-weight: 800;
  color: var(--cream);
  max-width: 900px;
  margin: 0 auto .35em;
}
.cta p {
  color: rgba(251,250,246,.85);
  max-width: 460px;
  margin: 0 auto 34px;
  font-size: 1.08rem;
}
</style>
