---
const year = new Date().getFullYear();
const WA_NUMBER = '573000000000';

const services = ['Branding','Diseño web','Social media','Performance ads'];
const studio   = [
  { href: '#trabajo',   label: 'Trabajo' },
  { href: '#proceso',   label: 'Proceso' },
  { href: '#contacto',  label: 'Contacto' },
];
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="#" class="logo">PULSO<span class="dot">.</span></a>
        <p>Estudio creativo y de marketing digital. Convertimos marcas en algo que la gente recuerda.</p>
      </div>

      <div class="foot-col">
        <h4>Servicios</h4>
        {services.map(s => <a href="#servicios">{s}</a>)}
      </div>

      <div class="foot-col">
        <h4>Estudio</h4>
        {studio.map(l => <a href={l.href}>{l.label}</a>)}
      </div>

      <div class="foot-col">
        <h4>Conecta</h4>
        <p>hola@pulsostudio.co</p>
        <a href="#" rel="noopener noreferrer">Instagram</a>
        <a href="#" rel="noopener noreferrer">LinkedIn</a>
        <a href="#" rel="noopener noreferrer">Behance</a>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} PULSO Estudio. Sitio de demostración.</span>
      <span>Manizales · Bogotá · Remoto</span>
    </div>
  </div>
</footer>

<!-- WhatsApp FAB -->
<a
  class="wa"
  href={`https://wa.me/${WA_NUMBER}`}
  aria-label="Escríbenos por WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.518 5.276l-.999 3.648 3.971-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
  </svg>
</a>

<style>
footer {
  background: var(--ink);
  color: rgba(251,250,246,.65);
  padding: 70px 0 30px;
}
.foot-top {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: wrap;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(251,250,246,.15);
}
.foot-brand { max-width: 320px; }
.foot-brand .logo { color: var(--cream); font-size: 2rem; }
.foot-brand .dot  { color: var(--blue); }
.foot-brand p { margin-top: 14px; font-size: .95rem; }

.foot-col h4 {
  font-family: var(--font-body);
  font-size: .76rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(251,250,246,.45);
  margin-bottom: 16px;
}
.foot-col a,
.foot-col p {
  display: block;
  font-size: .95rem;
  margin-bottom: 10px;
  transition: color .3s;
}
.foot-col a:hover { color: #8C8DFF; }

.foot-bottom {
  padding-top: 26px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  font-size: .82rem;
  color: rgba(251,250,246,.4);
}

/* WhatsApp FAB */
.wa {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 200;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #25D366;
  display: grid;
  place-items: center;
  box-shadow: 0 10px 30px rgba(37,211,102,.45);
  transition: transform .25s;
}
.wa:hover { transform: scale(1.08); }
.wa svg   { width: 30px; height: 30px; fill: #fff; }
</style>
