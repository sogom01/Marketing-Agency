---
const steps = [
  { no: '01', title: 'Escuchamos',  body: 'Entendemos tu marca, tu mercado y a dónde quieres llegar.' },
  { no: '02', title: 'Estrategia',  body: 'Definimos el rumbo: mensaje, canales y métricas que importan.' },
  { no: '03', title: 'Creamos',     body: 'Diseño, desarrollo y contenido alineados a la estrategia.' },
  { no: '04', title: 'Optimizamos', body: 'Medimos, ajustamos y escalamos lo que funciona.' },
];
---

<section class="section process" id="proceso">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>Cómo trabajamos</h2>
      <p>Un proceso claro, sin sorpresas, con entregas en cada etapa.</p>
    </div>

    <div class="steps">
      {steps.map(s => (
        <article class="step reveal">
          <div class="no" aria-hidden="true">{s.no}</div>
          <h4>{s.title}</h4>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.process { background: var(--paper-2); }

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.step { padding: 30px 0; }
.step .no {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: var(--blue);
  line-height: 1;
  margin-bottom: 14px;
}
.step h4 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 8px;
}
.step p { color: var(--ink-soft); font-size: .95rem; }

@media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; gap: 30px; } }
@media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
</style>
